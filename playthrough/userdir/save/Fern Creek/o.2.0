,118],[160,113],[178,103],[163,91],[160,114],[155,73],[41,149],[160,115],[97,22],[98,12],[170,96],[79,32],[164,115],[81,30],[154,50],[157,111],[150,99],[98,15],[151,35],[157,109],[152,40],[156,112],[147,75],[159,114],[159,105],[135,51],[165,40],[156,104],[87,14],[155,108],[62,73],[159,41],[155,111],[155,106],[135,62],[161,99],[164,62],[167,112],[152,106],[167,115],[131,58],[166,113],[139,53],[155,54],[151,43],[155,72],[166,123],[93,14],[167,117],[162,113],[174,123],[130,58],[165,120],[168,121],[169,118],[156,91],[151,83],[152,36],[78,5],[168,118],[171,119],[159,44],[148,98],[170,102],[171,124],[146,93],[93,8],[95,9],[93,11],[141,73],[89,14],[155,103],[92,25],[96,14],[135,58],[94,20],[169,100],[84,17],[164,47],[135,56],[141,61],[94,17],[97,20],[84,22],[130,35],[90,25],[158,37],[162,44],[99,12],[89,24],[88,24],[137,37],[173,120],[87,26],[89,27],[77,11],[72,27],[173,47],[73,27],[87,9],[67,27],[78,33],[134,48],[168,35],[156,37],[149,38],[144,36],[145,41],[144,42],[161,94],[168,44],[128,50],[169,44],[65,26],[147,45],[156,40],[145,46],[34,112],[145,94],[73,81],[147,47],[138,37],[148,46],[144,47],[140,67],[149,46],[143,46],[142,48],[161,89],[142,49],[148,95],[128,44],[165,44],[155,47],[70,23],[149,84],[155,109],[137,48],[85,32],[133,49],[164,53],[148,82],[157,50],[151,143],[146,51],[165,61],[146,52],[65,81],[162,93],[146,53],[9,46],[148,52],[148,97],[166,52],[83,33],[131,53],[156,55],[143,53],[155,55],[155,56],[155,57],[65,76],[162,99],[157,55],[75,68],[155,58],[88,20],[130,61],[157,56],[154,108],[168,96],[156,58],[147,95],[69,33],[37,112],[75,83],[145,69],[161,56],[131,57],[136,58],[145,59],[155,62],[170,115],[143,64],[159,47],[144,64],[152,65],[88,32],[33,114],[167,116],[140,69],[155,149],[143,69],[155,69],[145,36],[157,106],[154,73],[143,75],[69,129],[90,11],[146,76],[60,78],[156,145],[68,81],[166,38],[76,86],[132,66],[157,68],[155,88],[75,29],[152,152],[156,90],[135,59],[145,95],[147,98],[38,150],[157,108],[147,99],[153,100],[168,114],[158,99],[159,37],[85,19],[130,55],[159,100],[157,35],[79,27],[89,28],[96,25],[137,35],[176,103],[15,58],[147,51],[176,105],[153,76],[152,105],[162,106]],"rivers":[{"entry":[0,26],"exit":[179,140],"size":1480,"control1":[29,49],"control2":[57,28]}]
,"highway_connections":[[-2147483648,-2147483648,-2147483648],[179,85,0],[117,179,0],[-2147483648,-2147483648,-2147483648]]
