ou feel your left hand getting warm.", "count": 1, "type": 3 }, { "turn": 5242737, "message": "You feel your left foot getting warm.", "count": 1, "type": 3 }, { "turn": 5242738, "message": "You feel your left hand getting warm.", "count": 1, "type": 3 }, { "turn": 5242801, "message": "You feel your left foot getting warm.", "count": 32, "type": 3 }, { "turn": 5250680, "message": "You lick your lips as you think about lighting a cigarette.", "count": 1, "type": 3 }, { "turn": 5253411, "message": "You lick your lips as you think about lighting a cigarette.", "count": 1, "type": 3 }, { "turn": 5253751, "message": "The sunset always makes you a feel a little bit better.", "count": 2, "type": 0 }, { "turn": 5255668, "message": "You finish waiting.", "count": 1, "type": 5 }, { "turn": 5255669, "message": "This is a comfortable place to sleep.", "count": 1, "type": 0 }, { "turn": 5255669, "message": "You start trying to fall asleep.", "count": 1, "type": 5 }, { "turn": 5255669, "message": "You lie down.", "count": 1, "type": 5 }, { "turn": 5255669, "message": "You lie down preparing to fall asleep.", "count": 1, "type": 5 }, { "turn": 5255700, "message": "Saving game, this may take a while.", "count": 1, "type": 4 }, { "turn": 5256493, "message": "In your dream you brutally disanimate several zombies and then tear through their clothing looking for any unsmoked cigarettes", "count": 1, "type": 3 }, { "turn": 5258153, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5258584, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5258719, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5259065, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5259158, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5261041, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5262986, "message": "You toss and turn…", "count": 1, "type": 5 }, { "turn": 5263120, "message": "You toss and t