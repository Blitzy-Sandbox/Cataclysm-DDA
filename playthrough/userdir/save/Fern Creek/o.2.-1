,[79,123],[97,17],[79,112],[92,19],[85,116],[67,115],[132,171],[93,18],[80,128],[96,18],[91,19],[88,114],[113,56],[90,20],[94,18],[90,18],[91,21],[83,119],[107,53],[72,115],[90,21],[29,30],[30,32],[34,50],[142,79],[29,32],[29,33],[78,127],[136,175],[91,12],[30,33],[91,13],[92,20],[29,34],[89,118],[26,30],[30,34],[31,34],[86,117],[31,31],[26,29],[140,74],[27,28],[87,111],[26,28],[66,116],[139,76],[67,116],[25,30],[88,118],[103,56],[24,28],[9,102],[87,120],[28,25],[29,28],[33,50],[27,26],[72,122],[27,25],[135,82],[107,61],[30,29],[37,47],[92,16],[31,28]],"rivers":[]
