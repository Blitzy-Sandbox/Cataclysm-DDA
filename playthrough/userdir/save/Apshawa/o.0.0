,[171,75],[131,160],[165,73],[163,72],[165,71],[144,89],[165,72],[160,93],[164,81],[92,79],[152,76],[159,78],[157,77],[157,78],[169,74],[155,78],[158,95],[155,76],[154,78],[157,90],[157,75],[157,74],[126,161],[159,86],[78,91],[160,86],[75,94],[163,80],[162,86],[84,97],[160,85],[160,87],[69,97],[140,171],[70,96],[68,98],[68,99],[67,97],[67,96],[156,89],[66,96],[166,81],[68,96],[68,95],[69,96]],"rivers":[{"entry":[0,87],"exit":[179,26],"size":1603,"control1":[60,179],"control2":[103,65]},{"entry":[30,122],"exit":[2,152],"size":220,"control1":[50,152],"control2":[41,134]}]
