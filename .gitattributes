# Automatically normalize line endings for all files
# detected as text (Convert CRLF => LF).
*         text=auto

# Explicitly normalize files with these extensions in
# case Git doesn't detect them as text for some reason.
*.c       text
*.cbp     text
*.cpp     text
*.h       text
*.json    text
*.md      text
*.py      text
*.rc      text
*.sh      text
*.txt     text
*.yml     text
*.jsonl   text
*.srt     text

# Visual Studio project files, leave them alone.
*.cmd     -text
*.filters -text
*.sln     -text
*.user    -text
*.vcxproj -text

# Generated translation text, don't mess with them.
*.mo      binary
*.po      -text -diff
*.pot     -text

# Treat images, archives, and font files as binary.
# (binary is a macro for -text -diff)
*.db      binary
*.fon     binary
*.gz      binary
*.ico     binary
*.png     binary
*.ttf     binary
*.gsav    binary
*.mp4     binary
*.sav     binary
*.zzip    binary

# The game's own userdir, committed verbatim as evidence.
#
# Everything under playthrough/userdir/ is written by the ENGINE, not by
# anyone here, and it is committed byte for byte because it is what the
# session actually produced.  Two of those files end with a blank line --
# the debug log and the survivor's memorial diary -- so `git diff --check`
# reports "new blank line at EOF" against them.  The bytes are correct and
# must not be edited: a memorial rewritten to please a whitespace linter
# is no longer the memorial the game wrote.
#
# So whitespace checking is switched off for that subtree and nothing
# else. `-whitespace` suppresses the report without changing a byte, and
# it leaves the text/eol handling above in force, so line endings are
# still normalized exactly as they were.  The scope is deliberately the
# engine's tree alone: every authored file in this feature -- the tooling,
# the transcripts, the reports -- is still checked.
playthrough/userdir/** -whitespace

